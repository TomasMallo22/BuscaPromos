# Copiar a .env.local y completar. NUNCA commitear el .env.local.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo para el crawler (secrets de Actions). JAMAS en apps/web ni en Vercel.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram (spec 004) ---
# Bot creado con @BotFather. Va en GitHub (secrets) y en Vercel. El webhook apunta a
# /api/telegram/webhook y se registra con el workflow telegram-webhook.yml.
TELEGRAM_BOT_TOKEN=
# Secreto que Telegram manda en el header X-Telegram-Bot-Api-Secret-Token. GitHub y Vercel.
TELEGRAM_WEBHOOK_SECRET=
# El usuario del bot, sin @ (no es secreto). Solo Vercel: arma el link t.me/<bot>?start=<token>.
NEXT_PUBLICO_TELEGRAM_BOT=

# --- Rappi ---
# Primer sospechoso cuando la API rompe. Ver docs/07-operacion.md.
RAPPI_APP_VERSION=web_v1.223.2
# uuid4 estable. Uno nuevo en cada corrida es el patron que dispara anti-fraude.
RAPPI_DEVICE_ID=

# --- Crawler ---
# 'red' (API real) | 'fixtures' (sin red) | 'grabador' (red + escribe fixture)
CLIENTE_HTTP=fixtures

# --- Resend (SMTP de Supabase Auth y canal email de alertas) ---
RESEND_API_KEY=

# --- Web ---
NEXT_PUBLIC_URL_BASE=http://localhost:3000
# Token de GitHub de UN permiso (Actions: read and write, solo este repo). La web lo usa para
# disparar corrida.yml al guardar una direccion. Solo servidor: sin NEXT_PUBLIC_.
GITHUB_TOKEN_CORRIDA=
