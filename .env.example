# Copiar a .env.local y completar. NUNCA commitear el .env.local.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo para el crawler y las migraciones. JAMAS en apps/web.
SUPABASE_SERVICE_ROLE_KEY=

# --- Telegram ---
# Bot creado con @BotFather. El webhook apunta a /api/telegram/webhook.
TELEGRAM_BOT_TOKEN=
# Secreto que Telegram manda en el header X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=

# --- Rappi ---
# Primer sospechoso cuando la API rompe. Ver docs/07-operacion.md.
RAPPI_APP_VERSION=web_v1.223.2
# uuid4 estable. Uno nuevo en cada corrida es el patron que dispara anti-fraude.
RAPPI_DEVICE_ID=

# --- Crawler ---
# 'red' (API real) | 'fixtures' (sin red) | 'grabador' (red + escribe fixture)
CLIENTE_HTTP=fixtures

# --- Resend (SMTP de Supabase Auth y canal email de alertas) ---
RESEND_API_KEY=

# --- Web ---
NEXT_PUBLIC_URL_BASE=http://localhost:3000
