{
  "name": "buscapromos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "verificar": "npm run typecheck && npm run lint && npm run test && npm run reglas:verificar && npm run fixtures:verificar",
    "typecheck": "tsc -b && tsc -p apps/web/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:ver": "vitest",
    "build": "npm run build -w @buscapromos/web",
    "dev": "npm run dev -w @buscapromos/web",
    "db:arrancar": "supabase start",
    "db:reset": "supabase db reset",
    "db:tipos": "supabase gen types typescript --local > packages/db/src/tipos.ts",
    "db:lint": "supabase db lint --level warning",
    "reglas:verificar": "tsx scripts/verificar-reglas.ts",
    "fixtures:verificar": "tsx scripts/verificar-fixtures.ts",
    "corrida": "npm run corrida -w @buscapromos/crawler",
    "corrida:seca": "npm run corrida:seca -w @buscapromos/crawler --"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "eslint": "^9.39.5",
    "fast-check": "^3.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^2.1.8"
  }
}
